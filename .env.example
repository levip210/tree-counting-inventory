# SQLite file path is relative to the prisma/ directory.
DATABASE_URL="file:../data/app.db"

# Required. Long random string used to sign login cookies.
# Generate: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional. Used for HMAC uniqueness checks of PINs (falls back to AUTH_SECRET).
PIN_PEPPER=

# Optional. Emergency CLI password reset: npm run reset-admin-password -- --email you@farm.com --password 'NewPass'
# Not used by the public website.
ADMIN_RESET_KEY=

# Default timezone for "today" and hourly dashboard totals (Lansing, NC).
APP_TIMEZONE="America/New_York"

# Node environment
NODE_ENV="production"
