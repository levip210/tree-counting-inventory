{
  "name": "powers-tree-farm-counting",
  "version": "1.0.0",
  "private": true,
  "description": "Tablet-friendly tree-counting PWA for Powers Tree Farm (Lansing, NC).",
  "scripts": {
    "dev": "mkdir -p data && prisma migrate deploy && next dev -H 0.0.0.0 -p 3000",
    "build": "prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:prepare": "prisma generate && prisma migrate deploy",
    "test": "tsx --test tests/*.test.ts",
    "lint": "tsc --noEmit",
    "reset-admin-password": "tsx scripts/reset-admin-password.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "jose": "^6.1.0",
    "next": "^15.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "prisma": "^6.16.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
